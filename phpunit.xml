<?xml version="1.0" encoding="UTF-8"?>
<phpunit backupGlobals="false"
         backupStaticAttributes="false"
         bootstrap="vendor/autoload.php"
         colors="true"
         convertErrorsToExceptions="true"
         convertNoticesToExceptions="true"
         convertWarningsToExceptions="true"
         processIsolation="false"
         stopOnFailure="false">
    <testsuites>
        <testsuite name="Feature">
            <directory suffix="Test.php">./tests/Feature</directory>
        </testsuite>

        <testsuite name="Unit">
            <directory suffix="Test.php">./tests/Unit</directory>
        </testsuite>
    </testsuites>
    <filter>
        <whitelist processUncoveredFilesFromWhitelist="true">
            <directory suffix=".php">./app</directory>
        </whitelist>
    </filter>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="CACHE_DRIVER" value="array"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="QUEUE_DRIVER" value="sync"/>
        <!-- Aislamiento de la base de tests: NUNCA contra `laravel`.
             root es necesario porque el usuario `laravel` solo tiene
             privilegios sobre la base `laravel`. El guard de tests/TestCase.php
             aborta si el nombre no termina en `_test`. -->
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_HOST" value="db"/>
        <env name="DB_PORT" value="3306"/>
        <env name="DB_DATABASE" value="laravel_test"/>
        <env name="DB_USERNAME" value="root"/>
        <env name="DB_PASSWORD" value="root"/>
        <!-- La captura de analitica no debe depender del .env del host. -->
        <env name="ANALYTICS_ENABLED" value="false"/>
        <env name="ANALYTICS_TIMEZONE" value="America/Bogota"/>
    </php>
</phpunit>
